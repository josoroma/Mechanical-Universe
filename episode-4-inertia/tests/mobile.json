[
  [
    "eval",
    "window.startT=document.querySelector('.stage').dataset.progress"
  ],
  [
    "wait",
    350
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.progress===window.startT && document.querySelector('.stage').dataset.playing==='false'"
  ],
  [
    "eval",
    "window.scrollTo(0,0)"
  ],
  [
    "wait",
    100
  ],
  [
    "shot",
    "shots/mobile-light.png",
    ".page",
    1
  ],
  [
    "lines"
  ],
  [
    "scroll",
    "#play"
  ],
  [
    "click",
    "#play"
  ],
  [
    "until",
    "Number(document.querySelector('.stage').dataset.progress)>0.08 && Number(document.querySelector('.stage').dataset.progress)<0.09 && document.querySelector('.stage').dataset.playing==='false'"
  ],
  [
    "key",
    "ArrowRight",
    ".stage"
  ],
  [
    "until",
    "Number(document.querySelector('.stage').dataset.progress)>0.13"
  ],
  [
    "scroll",
    "[data-mode=\"maneuver\"]"
  ],
  [
    "click",
    "[data-mode=\"maneuver\"]"
  ],
  [
    "scroll",
    "[data-phase=\"2.5\"]"
  ],
  [
    "click",
    "[data-phase=\"2.5\"]"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.acceleration==='-2'"
  ],
  [
    "lines"
  ],
  [
    "scroll",
    "[data-frame=\"cart\"]"
  ],
  [
    "click",
    "[data-frame=\"cart\"]"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.frame==='cart'"
  ],
  [
    "shot",
    "shots/mobile-aboard.png",
    ".stage",
    2
  ],
  [
    "scroll",
    "#theme"
  ],
  [
    "click",
    "#theme"
  ],
  [
    "wait",
    300
  ],
  [
    "eval",
    "window.scrollTo(0,0)"
  ],
  [
    "wait",
    100
  ],
  [
    "shot",
    "shots/mobile-dark.png",
    ".page",
    1
  ],
  [
    "lines"
  ],
  [
    "eval",
    "({overflow:document.documentElement.scrollWidth>innerWidth,reduced:matchMedia('(prefers-reduced-motion: reduce)').matches,state:document.querySelector('.stage').dataset.progress,resources:performance.getEntriesByType('resource').filter(r=>r.name.startsWith('http')).length})"
  ]
]
