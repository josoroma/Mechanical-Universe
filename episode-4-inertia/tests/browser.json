[
  [
    "scroll",
    "#reset"
  ],
  [
    "click",
    "#reset"
  ],
  [
    "until",
    "document.documentElement.lang==='es' && document.querySelectorAll('[data-part]').length===86 && document.querySelector('.stage').dataset.playing==='false'"
  ],
  [
    "eval",
    "window.scrollTo(0,0)"
  ],
  [
    "wait",
    100
  ],
  [
    "shot",
    "shots/desktop-light.png",
    ".page",
    1
  ],
  [
    "lines",
    "shots/lines-light.png"
  ],
  [
    "key",
    "1",
    ".stage"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.mode==='rest' && document.querySelector('#metric-a').textContent==='0,00 m/s'"
  ],
  [
    "key",
    "End",
    ".stage"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.angle==='0.0000000'"
  ],
  [
    "lines"
  ],
  [
    "key",
    "2",
    ".stage"
  ],
  [
    "eval",
    "(()=>{const e=document.getElementById('velocity');e.value='1';e.dispatchEvent(new Event('input',{bubbles:true}));return e.value})()"
  ],
  [
    "eval",
    "(()=>{const e=document.getElementById('time');e.value='1';e.dispatchEvent(new Event('input',{bubbles:true}));return e.value})()"
  ],
  [
    "until",
    "document.querySelector('#readout').textContent.includes('6,00 m') && document.querySelector('#metric-a').textContent==='1,00 m/s'"
  ],
  [
    "lines"
  ],
  [
    "scroll",
    "[data-frame=\"cart\"]"
  ],
  [
    "click",
    "[data-frame=\"cart\"]"
  ],
  [
    "wait",
    900
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.frame==='cart' && document.querySelector('.stage').dataset.angle==='0.0000000'"
  ],
  [
    "shot",
    "shots/aboard-light.png",
    ".stage",
    1
  ],
  [
    "scroll",
    "[data-frame=\"ground\"]"
  ],
  [
    "click",
    "[data-frame=\"ground\"]"
  ],
  [
    "wait",
    900
  ],
  [
    "key",
    "3",
    ".stage"
  ],
  [
    "eval",
    "(()=>{const e=document.getElementById('acceleration');e.value='2.5';e.dispatchEvent(new Event('input',{bubbles:true}));return e.value})()"
  ],
  [
    "eval",
    "(()=>{const e=document.getElementById('length');e.value='2.2';e.dispatchEvent(new Event('input',{bubbles:true}));return e.value})()"
  ],
  [
    "eval",
    "(()=>{const e=document.getElementById('time');e.value='0.08';e.dispatchEvent(new Event('input',{bubbles:true}));return e.value})()"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.acceleration==='2.5' && Number(document.querySelector('.stage').dataset.angle)<0"
  ],
  [
    "lines"
  ],
  [
    "scroll",
    "[data-phase=\"1.5\"]"
  ],
  [
    "click",
    "[data-phase=\"1.5\"]"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.acceleration==='0' && Math.abs(Number(document.querySelector('.stage').dataset.angle))>0.01 && document.querySelector('#experiment-description').textContent.includes('conserva')"
  ],
  [
    "lines"
  ],
  [
    "scroll",
    "[data-phase=\"2.5\"]"
  ],
  [
    "click",
    "[data-phase=\"2.5\"]"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.acceleration==='-2.5' && document.querySelector('#equilibrium-note').textContent.includes('14,3')"
  ],
  [
    "lines"
  ],
  [
    "scroll",
    "[data-phase=\"4\"]"
  ],
  [
    "click",
    "[data-phase=\"4\"]"
  ],
  [
    "until",
    "document.querySelector('#metric-a').textContent==='0,00 m/s' && document.querySelector('#experiment-heading').textContent.includes('aún oscila')"
  ],
  [
    "lines"
  ],
  [
    "scroll",
    "#theme"
  ],
  [
    "click",
    "#theme"
  ],
  [
    "wait",
    300
  ],
  [
    "eval",
    "window.scrollTo(0,0)"
  ],
  [
    "wait",
    100
  ],
  [
    "shot",
    "shots/desktop-dark.png",
    ".page",
    1
  ],
  [
    "lines",
    "shots/lines-dark.png"
  ],
  [
    "key",
    "1",
    ".stage"
  ],
  [
    "lines"
  ],
  [
    "key",
    "2",
    ".stage"
  ],
  [
    "key",
    "End",
    ".stage"
  ],
  [
    "lines"
  ],
  [
    "key",
    "3",
    ".stage"
  ],
  [
    "eval",
    "(()=>{const e=document.getElementById('length');e.value='1.2';e.dispatchEvent(new Event('input',{bubbles:true}));return e.value})()"
  ],
  [
    "eval",
    "(()=>{const e=document.getElementById('time');e.value='0.4';e.dispatchEvent(new Event('input',{bubbles:true}));return e.value})()"
  ],
  [
    "lines"
  ],
  [
    "scroll",
    "#reset"
  ],
  [
    "click",
    "#reset"
  ],
  [
    "scroll",
    ".stage"
  ],
  [
    "drag",
    ".stage",
    0.35,
    0.5,
    0.6,
    0.5,
    12
  ],
  [
    "until",
    "Number(document.querySelector('.stage').dataset.progress)>0.2 && document.querySelector('.stage').dataset.playing==='false'"
  ],
  [
    "eval",
    "window.pauseT=document.querySelector('.stage').dataset.progress"
  ],
  [
    "wait",
    200
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.progress===window.pauseT"
  ],
  [
    "scroll",
    "#play"
  ],
  [
    "click",
    "#play"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.playing==='true' && document.querySelector('.stage').dataset.progress!==window.pauseT"
  ],
  [
    "eval",
    "document.querySelector('.footer').style.marginTop='1500px'"
  ],
  [
    "scroll",
    ".footer"
  ],
  [
    "wait",
    200
  ],
  [
    "eval",
    "window.offscreenT=document.querySelector('.stage').dataset.progress"
  ],
  [
    "wait",
    250
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.progress===window.offscreenT"
  ],
  [
    "eval",
    "document.querySelector('.footer').style.marginTop=''"
  ],
  [
    "scroll",
    ".stage"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.progress!==window.offscreenT"
  ],
  [
    "eval",
    "Object.defineProperty(document,'hidden',{configurable:true,value:true});document.dispatchEvent(new Event('visibilitychange'));window.hiddenT=document.querySelector('.stage').dataset.progress"
  ],
  [
    "wait",
    250
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.progress===window.hiddenT"
  ],
  [
    "eval",
    "delete document.hidden;document.dispatchEvent(new Event('visibilitychange'))"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.progress!==window.hiddenT"
  ],
  [
    "scroll",
    "#play"
  ],
  [
    "click",
    "#play"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.playing==='false'"
  ],
  [
    "eval",
    "({lang:document.documentElement.lang,overflow:document.documentElement.scrollWidth>innerWidth,resources:performance.getEntriesByType('resource').filter(r=>r.name.startsWith('http')).length,parts:document.querySelectorAll('[data-part]').length})"
  ]
]
