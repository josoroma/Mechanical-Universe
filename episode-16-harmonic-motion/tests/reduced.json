    "ArrowLeft",
    ".stage"
  ],
  [
    "eval",
    "check(n('angle')===44,\"Teclado de amplitud\")"
  ],
  [
    "eval",
    "document.querySelector('.stage').dispatchEvent(new KeyboardEvent('keydown',{key:'ArrowRight',shiftKey:true,bubbles:true}))"
  ],
  [
    "eval",
    "check(n('angle')===45,\"Mayús y límite angular\")"
  ],
  [
    "eval",
    "document.getElementById(\"reset\").click()"
  ],
  [
    "eval",
    "check(n('angle')===15&&n('mass')===.2&&n('length')===1&&d().linear==='false'&&n('time')===0&&n('records')===0,\"Restablecer parámetros\")"
  ],
  [
    "eval",
    "document.getElementById(\"release\").click()"
  ],
  [
    "eval",
    "check(d().paused==='true'&&n('time')===0,\"Liberación manual sin animación\")"
  ]
