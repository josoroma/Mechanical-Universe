    "document.activeElement.blur();document.querySelector('.page').style.paddingBottom='1800px';scrollTo(0,document.documentElement.scrollHeight)"
  ],
  [
    "until",
    "d().visible==='false'",
    4000
  ],
  [
    "eval",
    "window.savedTime=n('time')"
  ],
