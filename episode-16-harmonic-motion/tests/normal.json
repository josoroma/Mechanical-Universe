    4
  ],
  [
    "slow",
    1
  ],
  [
    "until",
    "d().ready==='true'",
    4000
  ],
  [
    "eval",
    "check(n('length')===1.4&&n('time')===0&&d().paused==='true',\"Preparación desde el reposo\")"
  ],
  [
    "scroll",
    "#phase"
  ],
  [
    "wait",
    500
  ],
  [
    "eval",
    "(()=>{const e=document.getElementById(\"phase\");e.value=\"90\";e.dispatchEvent(new Event(\"input\",{bubbles:true}))})()"
  ],
  [
    "until",
    "d().ready==='true'",
    4000
  ],
  [
    "eval",
    "check(near(n('time'),n('Ts')/4)&&Math.abs(n('springX'))<1e-10,\"Retrato de fase interactivo fuera del banco\")"
  ],
  [
    "eval",
    "document.getElementById(\"play\").click()"
  ],
  [
