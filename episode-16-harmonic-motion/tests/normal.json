[
  [
    "eval",
    "window.d=()=>document.querySelector('.laboratory').dataset;window.n=k=>Number(d()[k]);window.check=(c,m)=>{if(!c)throw Error(m);return m+' · correcto'};window.near=(a,b,t=1e-9)=>Math.abs(a-b)<t"
  ],
  [
    "wait",
    1700
  ],
  [
    "eval",
    "check(d().auto==='true'&&n('time')>0,\"Demostración automática\")"
  ],
  [
    "move",
    ".stage",
    0.55,
    0.4
  ],
  [
    "eval",
    "window.savedTime=n('time')"
  ],
  [
    "wait",
    250
  ],
  [
    "eval",
    "check(n('time')===window.savedTime,\"Pausa al señalar\")"
  ],
  [
    "shot",
    "shots/hover-desktop.png",
