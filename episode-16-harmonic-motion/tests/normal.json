    "document.getElementById(\"release\").click()"
  ],
  [
    "until",
    "d().ready==='true'&&n('time')>.05",
    4000
  ],
  [
    "eval",
    "check(d().auto==='false'&&d().paused==='false',\"Liberación manual animada\")"
  ],
  [
    "eval",
    "(()=>{const e=document.getElementById(\"rate\");e.value=\"1\";e.dispatchEvent(new Event(\"change\",{bubbles:true}))})()"
  ],
  [
    "slow",
    0.65
  ],
  [
    "sheet",
    "shots/oscillation-motion.png",
    220,
    8,
    ".apparatus",
    0.6,
    null,
    4
  ],
  [
    "slow",
    1
  ],
  [
    "eval",
    "check(Math.abs(n('springError'))<1e-10&&Math.abs(n('pendulumError'))<1e-8,\"Movimiento y energía coherentes\")"
  ],
  [
    "eval",
    "(()=>{const e=document.getElementById(\"length\");e.value=\"1.4\";e.dispatchEvent(new Event(\"change\",{bubbles:true}))})()"
  ],
  [
    "slow",
    0.4
  ],
  [
    "sheet",
    "shots/preparation-motion.png",
    120,
