[
  ["eval", "window.orrery.setTime(0.22)"],
  ["eval", "document.body.style.paddingBottom='1000px';scrollTo(0,document.documentElement.scrollHeight)"],
  ["until", "!window.orrery.state.visible"],
  ["eval", "document.querySelector('[data-mode=\"2\"]').click();document.querySelector('#time').value=4;document.querySelector('#time').dispatchEvent(new Event('input',{bubbles:true}));document.querySelector('#eccentricity').value=0.3;document.querySelector('#eccentricity').dispatchEvent(new Event('input',{bubbles:true}))"],
  ["until", "window.orrery.state.shownMode===2 && window.orrery.state.time===4 && document.querySelector('#model-time').textContent==='4,00 años' && window.orrery.state.eccentricity===0.3"],
  ["eval", "document.querySelector('#play').click()"],
  ["wait", 500],
  ["until", "window.orrery.state.playing && window.orrery.state.time===4"],
  ["scroll", ".stage"],
  ["until", "window.orrery.state.visible && window.orrery.state.time>4.005"],
  ["key", "Escape", ".stage"],
  ["until", "!window.orrery.state.playing"],
  ["scroll", "#time"],
  ["drag", "#time", 0.5, 0.5, 0.75, 0.5, 8],
  ["until", "window.orrery.state.targetTime>5 && !window.orrery.state.playing"],
  ["eval", "({passed:true,offscreenPaused:true,scrubTime:window.orrery.state.targetTime})"]
]
