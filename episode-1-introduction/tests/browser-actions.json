[
  [
    "eval",
    "document.body.dataset.theme='light';document.getElementById('theme').setAttribute('aria-label','Cambiar al tema oscuro')"
  ],
  ["eval", "window.orrery.setTime(0.22)"],
  ["until", "!window.orrery.state.playing && Math.abs(window.orrery.state.time-0.22)<0.001"],
  ["until", "document.querySelector('[data-planet=mercury]').disabled && !document.querySelector('[data-planet=mars]').disabled"],
  ["shot", "shots/desktop-light.png", ".page"],
  ["eval", "window.orrery.setTime(1.8)"],
  ["until", "document.querySelector('#metric-2').textContent.includes('Retrógrado')"],
  ["lines", "shots/lines-ptolemaic-retrograde.png"],
  ["key", "2", ".stage"],
  ["until", "window.orrery.state.shownMode===1 && window.orrery.state.opacity>0.99"],
  ["click", "[data-planet=earth]"],
  ["until", "window.orrery.state.selected==='earth' && document.querySelector('#metric-1').textContent==='1,00 años'"],
  ["click", "[data-planet=mars]"],
  ["eval", "window.orrery.setTime(0.22)"],
  ["until", "Math.abs(window.orrery.state.time-0.22)<0.001"],
  ["shot", "shots/copernican-light.png", ".page"],
  ["lines", "shots/lines-copernican.png"],
  ["click", "[data-mode='2']"],
  ["until", "window.orrery.state.shownMode===2 && window.orrery.state.opacity>0.99 && !document.querySelector('#eccentricity-panel').hidden"],
  ["eval", "document.querySelector('#eccentricity').value=0.45;document.querySelector('#eccentricity').dispatchEvent(new Event('input',{bubbles:true}))"],
  ["until", "Math.abs(window.orrery.state.eccentricity-0.45)<0.0001"],
  ["until", "document.querySelector('#metric-2').textContent.includes('km/s') && document.querySelector('#area-layer').style.display!=='none'"],
  ["click", "#areas"],
  ["until", "!window.orrery.state.areas && document.querySelector('#area-layer').style.display==='none'"],
  ["click", "#areas"],
  ["shot", "shots/newtonian-light.png", ".page"],
  ["lines", "shots/lines-newtonian-light.png"],
  ["click", "#theme"],
  ["wait", 350],
  ["until", "document.body.dataset.theme==='dark' && document.querySelector('#theme').getAttribute('aria-label')==='Cambiar al tema claro'"],
  ["shot", "shots/newtonian-dark.png", ".page"],
  ["lines", "shots/lines-newtonian-dark.png"],
  ["click", "#reset"],
  ["until", "Math.abs(window.orrery.state.eccentricity-0.094)<0.0001 && Math.abs(window.orrery.state.time-0.22)<0.001"],
  ["key", "ArrowRight", ".stage"],
  ["until", "Math.abs(window.orrery.state.time-0.245)<0.001"],
  ["key", "Home", ".stage"],
  ["until", "window.orrery.state.time<0.001"],
  ["key", "End", ".stage"],
  ["until", "window.orrery.state.time>7.999"],
  ["key", " ", ".stage"],
  ["until", "window.orrery.state.playing && window.orrery.state.time<1"],
  ["wait", 450],
  ["key", "Escape", ".stage"],
  ["until", "!window.orrery.state.playing && window.orrery.state.time>0.005"],
  ["eval", "document.querySelector('#speed').value='4';document.querySelector('#speed').dispatchEvent(new Event('change',{bubbles:true}))"],
  ["until", "window.orrery.state.speed===4"],
  ["eval", "({passed:true,mode:window.orrery.state.shownMode,selected:window.orrery.state.selected,overflow:document.documentElement.scrollWidth>innerWidth,svgFinite:![...document.querySelectorAll('path')].some(p=>/NaN|Infinity/.test(p.getAttribute('d')||''))})"],
  ["until", "document.documentElement.scrollWidth<=innerWidth"]
]
