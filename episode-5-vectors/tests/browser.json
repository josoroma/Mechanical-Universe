[
  [
    "eval",
    "document.body.dataset.theme='light';document.getElementById('theme').setAttribute('aria-label','Cambiar al tema oscuro')"
  ],
  [
    "scroll",
    "#reset"
  ],
  [
    "click",
    "#reset"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.settled==='true'"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.playing==='false' && document.querySelector('.stage').dataset.touring==='false' && document.documentElement.lang==='es' && document.querySelectorAll('[data-part]').length===83"
  ],
  [
    "eval",
    "window.scrollTo(0,0)"
  ],
  [
    "wait",
    100
  ],
  [
    "shot",
    "shots/desktop-light.png",
    ".page",
    1
  ],
  [
    "lines",
    "shots/lines-light.png"
  ],
  [
    "eval",
    "window.sumBefore=[document.querySelector('.stage').dataset.rx,document.querySelector('.stage').dataset.ry]"
  ],
  [
    "key",
    "2",
    ".stage"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.mode==='ab' && document.querySelector('.stage').dataset.rx===window.sumBefore[0] && document.querySelector('.stage').dataset.ry===window.sumBefore[1]"
  ],
  [
    "lines"
  ],
  [
    "key",
    "3",
    ".stage"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.mode==='ba' && document.querySelector('.stage').dataset.rx===window.sumBefore[0] && document.querySelector('.stage').dataset.ry===window.sumBefore[1]"
  ],
  [
    "lines"
  ],
  [
    "scroll",
    "[data-preset=\"right\"]"
  ],
  [
    "click",
    "[data-preset=\"right\"]"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.settled==='true'"
  ],
  [
    "until",
    "document.querySelector('#metric-a').textContent==='2,83 u' && document.querySelector('#R-x').textContent==='2,00' && document.querySelector('#R-y').textContent==='2,00'"
  ],
  [
    "lines"
  ],
  [
    "scroll",
    "#zoom"
  ],
  [
    "click",
    "#zoom"
  ],
  [
    "wait",
    1000
  ],
  [
    "until",
    "Number(document.querySelector('.drawing').getAttribute('viewBox').split(' ')[2])<520"
  ],
  [
    "shot",
    "shots/zoom-light.png",
    ".stage",
    1
  ],
  [
    "lines"
  ],
  [
    "scroll",
    "#zoom"
  ],
  [
    "click",
    "#zoom"
  ],
  [
    "wait",
    1000
  ],
  [
    "key",
    "End",
    ".stage"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.settled==='true'"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.opening==='150.00000' && document.querySelector('#metric-a').textContent==='1,04 u'"
  ],
  [
    "lines"
  ],
  [
    "key",
    "Home",
    ".stage"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.settled==='true'"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.opening==='30.00000'"
  ],
  [
    "key",
    "ArrowUp",
    ".stage"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.settled==='true'"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.orientation==='5.00000'"
  ],
  [
    "eval",
    "(()=>{const e=document.getElementById('a');e.value='2.5';e.dispatchEvent(new Event('input',{bubbles:true}));return e.value})()"
  ],
  [
    "eval",
    "(()=>{const e=document.getElementById('b');e.value='2.5';e.dispatchEvent(new Event('input',{bubbles:true}));return e.value})()"
  ],
  [
    "eval",
    "(()=>{const e=document.getElementById('orientation');e.value='0';e.dispatchEvent(new Event('input',{bubbles:true}));return e.value})()"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.settled==='true'"
  ],
  [
    "lines"
  ],
  [
    "scroll",
    "[data-preset=\"negative\"]"
  ],
  [
    "click",
    "[data-preset=\"negative\"]"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.settled==='true'"
  ],
  [
    "until",
    "Number(document.querySelector('.stage').dataset.rx)<0 && Number(document.querySelector('.stage').dataset.ry)<0 && document.querySelector('#component-result').textContent.includes('≈')"
  ],
  [
    "lines"
  ],
  [
    "scroll",
    "#theme"
  ],
  [
    "click",
    "#theme"
  ],
  [
    "wait",
    300
  ],
  [
    "eval",
    "window.scrollTo(0,0)"
  ],
  [
    "wait",
    100
  ],
  [
    "shot",
    "shots/desktop-dark.png",
    ".page",
    1
  ],
  [
    "lines",
    "shots/lines-dark.png"
  ],
  [
    "key",
    "1",
    ".stage"
  ],
  [
    "lines"
  ],
  [
    "key",
    "2",
    ".stage"
  ],
  [
    "lines"
  ],
  [
    "key",
    "3",
    ".stage"
  ],
  [
    "lines"
  ],
  [
    "scroll",
    "[data-preset=\"reinforce\"]"
  ],
  [
    "click",
    "[data-preset=\"reinforce\"]"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.settled==='true'"
  ],
  [
    "lines"
  ],
  [
    "scroll",
    "[data-preset=\"oppose\"]"
  ],
  [
    "click",
    "[data-preset=\"oppose\"]"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.settled==='true'"
  ],
  [
    "lines"
  ],
  [
    "scroll",
    "#reset"
  ],
  [
    "click",
    "#reset"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.settled==='true'"
  ],
  [
    "scroll",
    ".stage"
  ],
  [
    "eval",
    "window.beforeA=Number(document.querySelector('.stage').dataset.a);window.beforeAngle=Number(document.querySelector('.stage').dataset.orientation)"
  ],
  [
    "drag",
    "[data-part=\"joint.a.knob\"]",
    0.5,
    0.5,
    0.95,
    0.2,
    12
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.settled==='true'"
  ],
  [
    "until",
    "Math.abs(Number(document.querySelector('.stage').dataset.a)-window.beforeA)>0.001 || Math.abs(Number(document.querySelector('.stage').dataset.orientation)-window.beforeAngle)>0.01"
  ],
  [
    "eval",
    "window.beforeOpening=Number(document.querySelector('.stage').dataset.opening)"
  ],
  [
    "drag",
    ".stage",
    0.15,
    0.25,
    0.3,
    0.25,
    12
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.settled==='true'"
  ],
  [
    "until",
    "Number(document.querySelector('.stage').dataset.opening)>window.beforeOpening+5 && document.querySelector('.stage').dataset.playing==='false'"
  ],
  [
    "scroll",
    "#play"
  ],
  [
    "click",
    "#play"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.playing==='true'"
  ],
  [
    "eval",
    "document.querySelector('.footer').style.marginTop='1500px'"
  ],
  [
    "scroll",
    ".footer"
  ],
  [
    "wait",
    200
  ],
  [
    "eval",
    "window.offscreenAngle=document.querySelector('.stage').dataset.orientation"
  ],
  [
    "wait",
    250
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.orientation===window.offscreenAngle"
  ],
  [
    "eval",
    "document.querySelector('.footer').style.marginTop=''"
  ],
  [
    "scroll",
    ".stage"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.orientation!==window.offscreenAngle"
  ],
  [
    "eval",
    "Object.defineProperty(document,'hidden',{configurable:true,value:true});document.dispatchEvent(new Event('visibilitychange'));window.hiddenAngle=document.querySelector('.stage').dataset.orientation"
  ],
  [
    "wait",
    250
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.orientation===window.hiddenAngle"
  ],
  [
    "eval",
    "delete document.hidden;document.dispatchEvent(new Event('visibilitychange'))"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.orientation!==window.hiddenAngle"
  ],
  [
    "scroll",
    "#play"
  ],
  [
    "click",
    "#play"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.settled==='true'"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.playing==='false'"
  ],
  [
    "eval",
    "({lang:document.documentElement.lang,overflow:document.documentElement.scrollWidth>innerWidth,resources:performance.getEntriesByType('resource').filter(r=>r.name.startsWith('http')).length,parts:document.querySelectorAll('[data-part]').length})"
  ]
]
