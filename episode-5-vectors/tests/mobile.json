[
  [
    "eval",
    "window.startAngle=document.querySelector('.stage').dataset.orientation"
  ],
  [
    "wait",
    350
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.orientation===window.startAngle && document.querySelector('.stage').dataset.playing==='false'"
  ],
  [
    "eval",
    "window.scrollTo(0,0)"
  ],
  [
    "wait",
    100
  ],
  [
    "shot",
    "shots/mobile-light.png",
    ".page",
    1
  ],
  [
    "lines"
  ],
  [
    "scroll",
    "#play"
  ],
  [
    "click",
    "#play"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.orientation!==window.startAngle && document.querySelector('.stage').dataset.playing==='false'"
  ],
  [
    "scroll",
    "[data-preset=\"right\"]"
  ],
  [
    "click",
    "[data-preset=\"right\"]"
  ],
  [
    "until",
    "document.querySelector('#metric-a').textContent==='2,83 u'"
  ],
  [
    "scroll",
    "#zoom"
  ],
  [
    "click",
    "#zoom"
  ],
  [
    "until",
    "Number(document.querySelector('.drawing').getAttribute('viewBox').split(' ')[2])===510"
  ],
  [
    "shot",
    "shots/mobile-zoom.png",
    ".stage",
    2
  ],
  [
    "lines"
  ],
  [
    "key",
    "2",
    ".stage"
  ],
  [
    "lines"
  ],
  [
    "key",
    "3",
    ".stage"
  ],
  [
    "lines"
  ],
  [
    "scroll",
    "[data-preset=\"negative\"]"
  ],
  [
    "click",
    "[data-preset=\"negative\"]"
  ],
  [
    "until",
    "Number(document.querySelector('.stage').dataset.rx)<0 && Number(document.querySelector('.stage').dataset.ry)<0"
  ],
  [
    "scroll",
    "#theme"
  ],
  [
    "click",
    "#theme"
  ],
  [
    "wait",
    300
  ],
  [
    "eval",
    "window.scrollTo(0,0)"
  ],
  [
    "wait",
    100
  ],
  [
    "shot",
    "shots/mobile-dark.png",
    ".page",
    1
  ],
  [
    "lines"
  ],
  [
    "scroll",
    "#a"
  ],
  [
    "eval",
    "(()=>{const e=document.getElementById('a');e.value='1.5';e.dispatchEvent(new Event('input',{bubbles:true}));return e.value})()"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.a==='1.50000'"
  ],
  [
    "key",
    "r",
    ".stage"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.a==='2.20000' && document.querySelector('.stage').dataset.mode==='parallelogram'"
  ],
  [
    "eval",
    "({overflow:document.documentElement.scrollWidth>innerWidth,reduced:matchMedia('(prefers-reduced-motion: reduce)').matches,resources:performance.getEntriesByType('resource').filter(r=>r.name.startsWith('http')).length})"
  ]
]
