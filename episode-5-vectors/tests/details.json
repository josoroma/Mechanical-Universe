[
  [
    "eval",
    "document.body.dataset.theme='light';document.getElementById('theme').setAttribute('aria-label','Cambiar al tema oscuro')"
  ],
  ["scroll", "#reset"],
  ["click", "#reset"],
  ["until", "document.querySelector('.stage').dataset.settled==='true'"],
  ["scroll", ".stage"],
  ["shot", "shots/junctions-light-4x.png", ".drawing", 4, [240, 80, 560, 490]],
  ["eval", "(()=>{for(const id of ['a','b']){const e=document.getElementById(id);e.value='1.5';e.dispatchEvent(new Event('input',{bubbles:true}));}const e=document.getElementById('opening');e.value='150';e.dispatchEvent(new Event('input',{bubbles:true}));})()"],
  ["until", "document.querySelector('.stage').dataset.settled==='true'"],
  ["lines"],
  ["shot", "shots/retracted-light-4x.png", ".drawing", 4, [380, 200, 300, 260]],
  ["eval", "(()=>{for(const id of ['a','b']){const e=document.getElementById(id);e.value='2.5';e.dispatchEvent(new Event('input',{bubbles:true}));}const e=document.getElementById('opening');e.value='30';e.dispatchEvent(new Event('input',{bubbles:true}));})()"],
  ["until", "document.querySelector('.stage').dataset.settled==='true'"],
  ["lines"],
  ["shot", "shots/extended-light-4x.png", ".drawing", 4, [300, 180, 400, 380]],
  ["scroll", "#theme"],
  ["click", "#theme"],
  ["wait", 200],
  ["scroll", ".stage"],
  ["shot", "shots/extended-dark-4x.png", ".drawing", 4, [300, 180, 400, 380]],
  ["scroll", "#reset"],
  ["click", "#reset"],
  ["until", "document.querySelector('.stage').dataset.settled==='true'"],
  ["scroll", ".stage"],
  ["shot", "shots/junctions-dark-4x.png", ".drawing", 4, [240, 80, 560, 490]],
  ["scroll", ".era-selector"],
  ["move", "[data-mode=\"ab\"]", 0.5, 0.5],
  ["shot", "shots/hover-dark.png", ".era-selector", 2],
  ["eval", "(()=>{const e=document.getElementById('speed');e.value='1';e.dispatchEvent(new Event('input',{bubbles:true}));})()"],
  ["scroll", "#play"],
  ["click", "#play"],
  ["scroll", ".stage"],
  ["sheet", "shots/motion-dark.png", 550, 8, ".drawing", 0.7, null, 4],
  ["scroll", "#theme"],
  ["click", "#theme"],
  ["scroll", ".stage"],
  ["sheet", "shots/motion-light.png", 550, 8, ".drawing", 0.7, null, 4],
  ["scroll", "#play"],
  ["click", "#play"],
  ["until", "document.querySelector('.stage').dataset.settled==='true'"],
  ["lines"],
  ["eval", "({playing:document.querySelector('.stage').dataset.playing,parts:document.querySelectorAll('[data-part]').length})"]
]
