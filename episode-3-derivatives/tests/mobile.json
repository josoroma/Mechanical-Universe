[
  [
    "eval",
    "document.body.dataset.theme='light';document.getElementById('theme').setAttribute('aria-label','Cambiar al tema oscuro')"
  ],
  [
    "until",
    "document.querySelector('#play-label').textContent==='Avanzar' && document.querySelector('.stage').dataset.playing==='false'"
  ],
  [
    "eval",
    "window.stillX=document.querySelector('.stage').dataset.x"
  ],
  [
    "wait",
    350
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.x===window.stillX && document.documentElement.scrollWidth===innerWidth"
  ],
  [
    "shot",
    "shots/phone-light.png",
    ".page",
    1
  ],
  [
    "scroll",
    "#play"
  ],
  [
    "click",
    "#play"
  ],
  [
    "until",
    "Math.abs(Number(document.querySelector('.stage').dataset.x)-(0.85))<0.0001"
  ],
  [
    "scroll",
    "[data-mode=\"tangent\"]"
  ],
  [
    "click",
    "[data-mode=\"tangent\"]"
  ],
  [
    "until",
    "document.querySelector('#increment').disabled"
  ],
  [
    "scroll",
    "[data-profile=\"wave\"]"
  ],
  [
    "click",
    "[data-profile=\"wave\"]"
  ],
  [
    "key",
    "Home",
    ".stage"
  ],
  [
    "until",
    "Math.abs(Number(document.querySelector('.stage').dataset.x)-(-2))<0.0001"
  ],
  [
    "key",
    "ArrowRight",
    ".stage"
  ],
  [
    "until",
    "Math.abs(Number(document.querySelector('.stage').dataset.x)-(-1.9))<0.0001"
  ],
  [
    "scroll",
    "#theme"
  ],
  [
    "click",
    "#theme"
  ],
  [
    "wait",
    300
  ],
  [
    "shot",
    "shots/phone-dark.png",
    ".page",
    1
  ],
  [
    "scroll",
    "#position"
  ],
  [
    "click",
    "#position"
  ],
  [
    "drag",
    "#position",
    0.1,
    0.5,
    0.8,
    0.5,
    8
  ],
  [
    "until",
    "Number(document.querySelector('.stage').dataset.x)>0.8"
  ],
  [
    "scroll",
    "[data-step=\"0.02\"]"
  ],
  [
    "click",
    "[data-step=\"0.02\"]"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.mode==='secant' && document.querySelector('#increment-value').textContent==='0,02'"
  ],
  [
    "eval",
    "({reduced:matchMedia('(prefers-reduced-motion:reduce)').matches,lang:document.documentElement.lang,width:innerWidth,overflow:document.documentElement.scrollWidth>innerWidth})"
  ]
]