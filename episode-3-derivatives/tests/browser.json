[
  [
    "eval",
    "document.body.dataset.theme='light';document.getElementById('theme').setAttribute('aria-label','Cambiar al tema oscuro')"
  ],
  [
    "scroll",
    "#reset"
  ],
  [
    "click",
    "#reset"
  ],
  [
    "until",
    "document.documentElement.lang==='es' && document.querySelectorAll('[data-part]').length===81 && document.querySelector('.stage').dataset.playing==='false'"
  ],
  [
    "eval",
    "window.scrollTo(0,0)"
  ],
  [
    "wait",
    100
  ],
  [
    "shot",
    "shots/desktop-light.png",
    ".page",
    1
  ],
  [
    "lines",
    "shots/lines-light.png"
  ],
  [
    "eval",
    "(()=>{const e=document.getElementById('increment');e.value='0.02';e.dispatchEvent(new Event('input',{bubbles:true}));return e.value})()"
  ],
  [
    "until",
    "document.querySelector('#metric-a').textContent==='0,3050' && document.querySelector('#difference').textContent==='0,0050'"
  ],
  [
    "key",
    "2",
    ".stage"
  ],
  [
    "until",
    "document.querySelector('#metric-a').textContent===document.querySelector('#metric-b').textContent && document.querySelector('#increment').disabled"
  ],
  [
    "lines"
  ],
  [
    "key",
    "Home",
    ".stage"
  ],
  [
    "until",
    "Math.abs(Number(document.querySelector('.stage').dataset.x)-(-2))<0.0001"
  ],
  [
    "key",
    "ArrowRight",
    ".stage"
  ],
  [
    "until",
    "Math.abs(Number(document.querySelector('.stage').dataset.x)-(-1.9))<0.0001"
  ],
  [
    "scroll",
    "[data-landmark=\"0\"]"
  ],
  [
    "click",
    "[data-landmark=\"0\"]"
  ],
  [
    "until",
    "document.querySelector('#metric-b').textContent==='0,0000' && document.querySelector('#discovery').textContent.includes('horizontal')"
  ],
  [
    "scroll",
    "[data-step=\"0.1\"]"
  ],
  [
    "click",
    "[data-step=\"0.1\"]"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.mode==='secant' && document.querySelector('#metric-a').textContent==='0,0250' && !document.querySelector('#increment').disabled"
  ],
  [
    "scroll",
    "[data-profile=\"wave\"]"
  ],
  [
    "click",
    "[data-profile=\"wave\"]"
  ],
  [
    "eval",
    "(()=>{const e=document.getElementById('position');e.value='0';e.dispatchEvent(new Event('input',{bubbles:true}));return e.value})()"
  ],
  [
    "until",
    "Math.abs(Number(document.querySelector('.stage').dataset.x)-(0))<0.0001"
  ],
  [
    "key",
    "2",
    ".stage"
  ],
  [
    "until",
    "document.querySelector('#metric-b').textContent==='1,0000'"
  ],
  [
    "lines"
  ],
  [
    "scroll",
    "[data-profile=\"cubic\"]"
  ],
  [
    "click",
    "[data-profile=\"cubic\"]"
  ],
  [
    "until",
    "document.querySelector('#metric-b').textContent==='0,0000' && document.querySelector('#discovery').textContent.includes('sigue creciendo')"
  ],
  [
    "until",
    "document.querySelector('#table-error-3').textContent==='0,000017' && document.querySelector('#second-key').hidden"
  ],
  [
    "lines"
  ],
  [
    "scroll",
    "#theme"
  ],
  [
    "click",
    "#theme"
  ],
  [
    "wait",
    300
  ],
  [
    "eval",
    "window.scrollTo(0,0)"
  ],
  [
    "wait",
    100
  ],
  [
    "shot",
    "shots/desktop-dark.png",
    ".page",
    1
  ],
  [
    "lines",
    "shots/lines-dark.png"
  ],
  [
    "scroll",
    "[data-profile=\"wave\"]"
  ],
  [
    "click",
    "[data-profile=\"wave\"]"
  ],
  [
    "key",
    "1",
    ".stage"
  ],
  [
    "lines"
  ],
  [
    "key",
    "2",
    ".stage"
  ],
  [
    "lines"
  ],
  [
    "scroll",
    "[data-profile=\"parabola\"]"
  ],
  [
    "click",
    "[data-profile=\"parabola\"]"
  ],
  [
    "key",
    "1",
    ".stage"
  ],
  [
    "lines"
  ],
  [
    "key",
    "2",
    ".stage"
  ],
  [
    "lines"
  ],
  [
    "scroll",
    "#reset"
  ],
  [
    "click",
    "#reset"
  ],
  [
    "scroll",
    ".stage"
  ],
  [
    "eval",
    "window.beforeDrag=Number(document.querySelector('.stage').dataset.x)"
  ],
  [
    "drag",
    "[data-part=\"dial.case\"]",
    0.3,
    0.5,
    0.95,
    0.5,
    12
  ],
  [
    "until",
    "Number(document.querySelector('.stage').dataset.x)>window.beforeDrag+0.1 && document.querySelector('.stage').dataset.playing==='false'"
  ],
  [
    "eval",
    "window.pauseX=document.querySelector('.stage').dataset.x"
  ],
  [
    "wait",
    300
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.touring==='false'"
  ],
  [
    "scroll",
    "#play"
  ],
  [
    "click",
    "#play"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.playing==='true' && document.querySelector('.stage').dataset.x!==window.pauseX"
  ],
  [
    "eval",
    "document.querySelector('.footer').style.marginTop='1500px'"
  ],
  [
    "scroll",
    ".footer"
  ],
  [
    "wait",
    200
  ],
  [
    "eval",
    "window.offscreenX=document.querySelector('.stage').dataset.x"
  ],
  [
    "wait",
    250
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.x===window.offscreenX"
  ],
  [
    "eval",
    "document.querySelector('.footer').style.marginTop=''"
  ],
  [
    "scroll",
    ".stage"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.x!==window.offscreenX"
  ],
  [
    "eval",
    "Object.defineProperty(document,'hidden',{configurable:true,value:true});document.dispatchEvent(new Event('visibilitychange'));window.hiddenX=document.querySelector('.stage').dataset.x"
  ],
  [
    "wait",
    250
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.x===window.hiddenX"
  ],
  [
    "eval",
    "delete document.hidden;document.dispatchEvent(new Event('visibilitychange'))"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.x!==window.hiddenX"
  ],
  [
    "scroll",
    "#play"
  ],
  [
    "click",
    "#play"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.playing==='false'"
  ],
  [
    "eval",
    "({lang:document.documentElement.lang,overflow:document.documentElement.scrollWidth>innerWidth,resources:performance.getEntriesByType('resource').filter(r=>r.name.startsWith('http')).length,parts:document.querySelectorAll('[data-part]').length})"
  ]
]