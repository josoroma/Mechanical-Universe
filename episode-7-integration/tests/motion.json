[
  [
    "eval",
    "(()=>{window.check=(v,m)=>{if(!v)throw new Error(m)};window.input=(id,v,event='input')=>{let e=document.getElementById(id);e.value=v;e.dispatchEvent(new Event(event,{bubbles:true}))};window.data=()=>document.querySelector('.stage').dataset;return 'Prueba con movimiento normal';})()"
  ],
  [
    "until",
    "Number(document.querySelector('.stage').dataset.x)>1.4",
    8000
  ],
  [
    "move",
    ".stage",
    0.1,
    0.1
  ],
  [
    "eval",
    "(()=>{window.still=Number(data().x);})()"
  ],
  [
    "wait",
    400
  ],
  [
    "eval",
    "(()=>{check(Number(data().x)===still,'Pausa automática al pasar el puntero');return 'Pausa al pasar el puntero correcta';})()"
  ],
  [
    "shot",
    "shots/hover.png",
    ".exhibit",
    1
  ],
  [
    "move",
    ".masthead",
    0.5,
    0.5
  ],
  [
    "until",
    "Number(document.querySelector('.stage').dataset.x)>still+.1",
    5000
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.profile==='signed'",
    22000
  ],
  [
    "eval",
    "(()=>{check(data().touring==='true','Recorrido automático');document.getElementById('reset').click();input('x',2.5);window.nodes=[...document.querySelector('#machine').children];window.wheelPath=document.querySelector('[data-wheel-lines]');})()"
  ],
  [
    "until",
    "Math.abs(Number(document.querySelector('.stage').dataset.x)-2.5)<1e-7",
    5000
  ],
  [
    "eval",
    "(()=>{input('speed',1.2,'change');document.getElementById('play').click();})()"
  ],
  [
    "sheet",
    "shots/motion.png",
    240,
    8,
    ".stage",
    0.8,
    [
      250,
      65,
      545,
      445
    ],
    4
  ],
  [
    "eval",
    "(()=>{check(nodes.every(node=>node.parentElement===document.getElementById('machine')),'Conserva nodos');check(wheelPath===document.querySelector('[data-wheel-lines]'),'Conserva trazos');check(Math.abs(Number(data().turns)*3-Number(data().net))<1e-8,'Contador y geometría');document.getElementById('reset').click();document.querySelector('[data-profile=wave]').click();document.getElementById('play').click();return 'Movimiento y conservación de nodos correctos';})()"
  ],
  [
    "wait",
    400
  ],
  [
    "eval",
    "(()=>{window.spacer=document.createElement('div');spacer.style.height='2400px';document.body.append(spacer);window.scrollTo(0,document.body.scrollHeight);})()"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.visible==='false'",
    5000
  ],
  [
    "eval",
    "(()=>{window.off=Number(data().x);})()"
  ],
  [
    "wait",
    400
  ],
  [
    "eval",
    "(()=>{check(Number(data().x)===off,'Pausa fuera de pantalla');spacer.remove();document.querySelector('.stage').scrollIntoView({block:'center'});})()"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.visible==='true'&&Number(document.querySelector('.stage').dataset.x)>off+.05",
    5000
  ],
  [
    "eval",
    "(()=>{Object.defineProperty(document,'hidden',{value:true,configurable:true});document.dispatchEvent(new Event('visibilitychange'));window.hiddenX=Number(data().x);})()"
  ],
  [
    "wait",
    400
  ],
  [
    "eval",
    "(()=>{check(Number(data().x)===hiddenX,'Pausa con pestaña oculta');delete document.hidden;document.dispatchEvent(new Event('visibilitychange'));})()"
  ],
  [
    "until",
    "Number(document.querySelector('.stage').dataset.x)>hiddenX+.05",
    5000
  ],
  [
    "eval",
    "(()=>{document.getElementById('play').click();let held=Number(data().x);input('x',5);check(Number(data().x)<4.9,'Seguimiento suave');window.before=held;})()"
  ],
  [
    "until",
    "Math.abs(Number(document.querySelector('.stage').dataset.x)-5)<1e-7",
    5000
  ],
  [
    "eval",
    "(()=>{check(data().touring==='false','Control manual');check(data().playing==='false','Sin reproducción después de ajustar');return 'Pausa, reanudación y seguimiento suave correctos';})()"
  ]
]