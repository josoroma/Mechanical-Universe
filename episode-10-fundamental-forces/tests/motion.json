[
  [
    "wait",
    300
  ],
  [
    "scroll",
    ".comparison-bench"
  ],
  [
    "wait",
    300
  ],
  [
    "eval",
    "(()=>{const b=document.querySelector('.comparison-bench');if(b.dataset.auto!=='true')throw Error('Sin demostración inicial');window.beforeAuto=+b.dataset.distance;})()"
  ],
  [
    "until",
    "+document.querySelector('.comparison-bench').dataset.distance!==window.beforeAuto",
    5000
  ],
  [
    "eval",
    "(()=>{if(+document.querySelector('.comparison-bench').dataset.distance===window.beforeAuto)throw Error('La demostración no avanza');return 'Demostración activa';})()"
  ],
  [
    "move",
    ".instrument[data-kind=gravity]",
    0.5,
    0.4
  ],
  [
    "wait",
    100
  ],
  [
    "eval",
    "(()=>{window.frozen=document.querySelector('.comparison-bench').dataset.distance;})()"
  ],
  [
    "wait",
    350
  ],
  [
    "eval",
    "(()=>{if(document.querySelector('.comparison-bench').dataset.distance!==window.frozen)throw Error('No se pausa al señalar');return 'Pausa al señalar correcta';})()"
  ],
  [
    "shot",
    "shots/hover.png",
    ".comparison-bench",
    1
  ],
  [
    "move",
    ".masthead",
    0.3,
    0.5
  ],
  [
    "wait",
    300
  ],
  [
    "eval",
    "(()=>{if(document.querySelector('.comparison-bench').dataset.distance===window.frozen)throw Error('No se reanuda');document.getElementById('reset').click();})()"
  ],
  [
    "wait",
    2200
  ],
  [
    "eval",
    "(()=>{document.querySelector('[data-polarity=same]').click();})()"
  ],
  [
    "slow",
    0.2
  ],
  [
    "sheet",
    "shots/polarity-motion.png",
    90,
    8,
    ".comparison-bench",
    0.65,
    null,
    4
  ],
  [
    "slow",
    1
  ],
  [
    "until",
    "document.querySelector('.comparison-bench').dataset.moving==='false'",
    6000
  ],
  [
    "eval",
    "(()=>{const b=document.querySelector('.comparison-bench');if(+b.dataset.signedElectric>=0)throw Error('No llega a repulsión');if(b.dataset.moving!=='false')throw Error('No se asienta');return 'Cambio de signo continuo y asentado';})()"
  ],
  [
    "eval",
    "(()=>{const el=document.getElementById('distance');el.value=.2;el.dispatchEvent(new Event('input',{bubbles:true}));})()"
  ],
  [
    "slow",
    0.2
  ],
  [
    "sheet",
    "shots/distance-motion.png",
    90,
    8,
    ".comparison-bench",
    0.65,
    null,
    4
  ],
  [
    "slow",
    1
  ],
  [
    "until",
    "document.querySelector('.comparison-bench').dataset.moving==='false'",
    6000
  ],
  [
    "eval",
    "(()=>{if(Math.abs(+document.querySelector('.comparison-bench').dataset.distance-.2)>1e-7)throw Error('Distancia final');document.getElementById('demo').click();})()"
  ],
  [
    "wait",
    200
  ],
  [
    "eval",
    "(()=>{document.querySelector('.footer').scrollIntoView();})()"
  ],
  [
    "wait",
    200
  ],
  [
    "eval",
    "(()=>{if(document.querySelector('.comparison-bench').dataset.active!=='false')throw Error('Observer');window.offscreen=document.querySelector('.comparison-bench').dataset.distance;})()"
  ],
  [
    "wait",
    400
  ],
  [
    "eval",
    "(()=>{if(document.querySelector('.comparison-bench').dataset.distance!==window.offscreen)throw Error('Avanza fuera de pantalla');document.querySelector('.comparison-bench').scrollIntoView({block:'center'});})()"
  ],
  [
    "wait",
    400
  ],
  [
    "eval",
    "(()=>{if(document.querySelector('.comparison-bench').dataset.active!=='true')throw Error('No se reanuda en pantalla');Object.defineProperty(document,'hidden',{configurable:true,get:()=>true});document.dispatchEvent(new Event('visibilitychange'));window.hiddenDistance=document.querySelector('.comparison-bench').dataset.distance;})()"
  ],
  [
    "wait",
    400
  ],
  [
    "eval",
    "(()=>{if(document.querySelector('.comparison-bench').dataset.distance!==window.hiddenDistance)throw Error('Avanza en pestaña oculta');Object.defineProperty(document,'hidden',{configurable:true,get:()=>false});document.dispatchEvent(new Event('visibilitychange'));return 'Suspensión fuera de pantalla y al ocultar la pestaña correcta';})()"
  ],
  [
    "wait",
    200
  ],
  [
    "eval",
    "(()=>{document.getElementById('demo').click();})()"
  ],
  [
    "wait",
    100
  ],
  [
    "eval",
    "(()=>{window.paused=document.querySelector('.comparison-bench').dataset.distance;})()"
  ],
  [
    "wait",
    300
  ],
  [
    "eval",
    "(()=>{if(document.querySelector('.comparison-bench').dataset.distance!==window.paused)throw Error('Botón pausa');return 'Pausa explícita correcta';})()"
  ]
]