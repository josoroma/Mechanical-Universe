[
  [
    "eval",
    "document.body.dataset.theme='light';document.getElementById('theme').setAttribute('aria-label','Cambiar al tema oscuro')"
  ],
  [
    "click",
    "#reset"
  ],
  [
    "until",
    "document.documentElement.lang==='es' && document.querySelectorAll('[data-part]').length===82 && document.querySelector('.stage').dataset.playing==='false'"
  ],
  [
    "click",
    "[data-mark=\"2\"]"
  ],
  [
    "until",
    "document.querySelector('#metric-a').textContent==='0,40 m' && document.querySelectorAll('[data-mark]')[1].getAttribute('aria-pressed')==='true'"
  ],
  [
    "click",
    "[data-mark=\"4\"]"
  ],
  [
    "until",
    "document.querySelector('#metric-a').textContent==='1,60 m'"
  ],
  [
    "key",
    "ArrowLeft",
    ".stage"
  ],
  [
    "until",
    "Math.abs(Number(document.querySelector('.stage').dataset.progress)-0.75)<0.001"
  ],
  [
    "key",
    "Home",
    ".stage"
  ],
  [
    "shot",
    "shots/desktop-light.png",
    ".page",
    1
  ],
  [
    "lines",
    "shots/lines-ramp-light.png"
  ],
  [
    "eval",
    "window.initialRamp=Array.from(document.querySelectorAll('[data-part]')).find(e=>e.dataset.part==='ramp.board').querySelector('.iso-fill').getAttribute('d')"
  ],
  [
    "eval",
    "(()=>{const el=document.getElementById('angle');el.value='8';el.dispatchEvent(new Event('input',{bubbles:true}));return el.value})()"
  ],
  [
    "until",
    "document.querySelector('#angle-value').textContent==='8°' && Array.from(document.querySelectorAll('[data-part]')).find(e=>e.dataset.part==='ramp.board').querySelector('.iso-fill').getAttribute('d')!==window.initialRamp"
  ],
  [
    "lines"
  ],
  [
    "eval",
    "(()=>{const el=document.getElementById('angle');el.value='28';el.dispatchEvent(new Event('input',{bubbles:true}));return el.value})()"
  ],
  [
    "lines"
  ],
  [
    "eval",
    "(()=>{const el=document.getElementById('angle');el.value='16';el.dispatchEvent(new Event('input',{bubbles:true}));return el.value})()"
  ],
  [
    "click",
    "#theme"
  ],
  [
    "wait",
    300
  ],
  [
    "until",
    "document.body.dataset.theme==='dark'"
  ],
  [
    "shot",
    "shots/desktop-dark.png",
    ".page",
    1
  ],
  [
    "lines",
    "shots/lines-ramp-dark.png"
  ],
  [
    "key",
    "2",
    ".stage"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.mode==='drop' && document.querySelector('#metric-a').textContent===document.querySelector('#metric-b').textContent"
  ],
  [
    "key",
    "ArrowRight",
    ".stage"
  ],
  [
    "until",
    "document.querySelector('#ball-a').getAttribute('transform')===document.querySelector('#ball-b').getAttribute('transform')"
  ],
  [
    "key",
    "Home",
    ".stage"
  ],
  [
    "lines",
    "shots/lines-drop-dark.png"
  ],
  [
    "click",
    "#theme"
  ],
  [
    "wait",
    300
  ],
  [
    "lines",
    "shots/lines-drop-light.png"
  ],
  [
    "shot",
    "shots/drop-light.png",
    ".page",
    1
  ],
  [
    "click",
    "input[value=air]"
  ],
  [
    "until",
    "document.querySelector('#metric-a').textContent!==document.querySelector('#metric-b').textContent && document.querySelector('#experiment-heading').textContent.includes('aire')"
  ],
  [
    "eval",
    "(()=>{const el=document.getElementById('height');el.value='2';el.dispatchEvent(new Event('input',{bubbles:true}));return el.value})()"
  ],
  [
    "eval",
    "(()=>{const el=document.getElementById('time');el.value='0.98';el.dispatchEvent(new Event('input',{bubbles:true}));return el.value})()"
  ],
  [
    "until",
    "document.querySelector('#ball-a').getAttribute('transform')!==document.querySelector('#ball-b').getAttribute('transform') && document.querySelector('#drop-result').textContent.includes('antes')"
  ],
  [
    "shot",
    "shots/air-comparison.png",
    ".page",
    1
  ],
  [
    "eval",
    "(()=>{const el=document.getElementById('mass');el.value='0.05';el.dispatchEvent(new Event('input',{bubbles:true}));return el.value})()"
  ],
  [
    "until",
    "document.querySelector('#metric-a').textContent===document.querySelector('#metric-b').textContent && document.querySelector('#discovery').textContent.includes('igual masa')"
  ],
  [
    "eval",
    "(()=>{const el=document.getElementById('mass');el.value='0.5';el.dispatchEvent(new Event('input',{bubbles:true}));return el.value})()"
  ],
  [
    "eval",
    "(()=>{const el=document.getElementById('height');el.value='0.5';el.dispatchEvent(new Event('input',{bubbles:true}));return el.value})()"
  ],
  [
    "lines"
  ],
  [
    "eval",
    "(()=>{const el=document.getElementById('height');el.value='1.8';el.dispatchEvent(new Event('input',{bubbles:true}));return el.value})()"
  ],
  [
    "click",
    "input[value=vacuum]"
  ],
  [
    "scroll",
    ".stage"
  ],
  [
    "click",
    "#play"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.playing==='true' && Number(document.querySelector('.stage').dataset.progress)>0.01"
  ],
  [
    "eval",
    "document.querySelector('.footer').style.marginTop='1500px'"
  ],
  [
    "scroll",
    ".footer"
  ],
  [
    "wait",
    200
  ],
  [
    "eval",
    "window.offscreenProgress=document.querySelector('.stage').dataset.progress"
  ],
  [
    "wait",
    250
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.progress===window.offscreenProgress"
  ],
  [
    "eval",
    "document.querySelector('.footer').style.marginTop=''"
  ],
  [
    "scroll",
    ".stage"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.progress!==window.offscreenProgress"
  ],
  [
    "eval",
    "Object.defineProperty(document,'hidden',{configurable:true,value:true});document.dispatchEvent(new Event('visibilitychange'));window.hiddenProgress=document.querySelector('.stage').dataset.progress"
  ],
  [
    "wait",
    250
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.progress===window.hiddenProgress"
  ],
  [
    "eval",
    "delete document.hidden;document.dispatchEvent(new Event('visibilitychange'))"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.progress!==window.hiddenProgress"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.playing==='false' && Number(document.querySelector('.stage').dataset.progress)===1",
    10000
  ],
  [
    "click",
    "#play"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.playing==='true' && Number(document.querySelector('.stage').dataset.progress)<1"
  ],
  [
    "click",
    "#play"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.playing==='false'"
  ],
  [
    "eval",
    "({language:document.documentElement.lang,overflow:document.documentElement.scrollWidth>innerWidth,parts:document.querySelectorAll('[data-part]').length,theme:document.body.dataset.theme})"
  ]
]
