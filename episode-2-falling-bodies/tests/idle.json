[
  [
    "until",
    "document.body.dataset.theme==='dark' && document.querySelector('.stage').dataset.playing==='true'"
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.mode==='drop'",
    12000
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.mode==='ramp'",
    10000
  ],
  [
    "eval",
    "({idleTour:true,theme:document.body.dataset.theme,externalResources:performance.getEntriesByType('resource').length,language:document.documentElement.lang})"
  ]
]
