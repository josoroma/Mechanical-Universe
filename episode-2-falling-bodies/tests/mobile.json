[
  [
    "until",
    "document.querySelector('#play-label').textContent==='Avanzar' && document.querySelector('.stage').dataset.playing==='false'"
  ],
  [
    "eval",
    "window.restProgress=document.querySelector('.stage').dataset.progress"
  ],
  [
    "wait",
    350
  ],
  [
    "until",
    "document.querySelector('.stage').dataset.progress===window.restProgress"
  ],
  [
    "until",
    "document.documentElement.scrollWidth===innerWidth"
  ],
  [
    "shot",
    "shots/phone-light.png",
    ".page",
    1
  ],
  [
    "scroll",
    "#play"
  ],
  [
    "click",
    "#play"
  ],
  [
    "until",
    "Number(document.querySelector('.stage').dataset.progress)===0.2 && document.querySelector('#metric-a').textContent==='0,10 m'"
  ],
  [
    "scroll",
    "[data-mode=drop]"
  ],
  [
    "click",
    "[data-mode=drop]"
  ],
  [
    "scroll",
    "input[value=air]"
  ],
  [
    "click",
    "input[value=air]"
  ],
  [
    "eval",
    "(()=>{const el=document.getElementById('height');el.value='2';el.dispatchEvent(new Event('input',{bubbles:true}));return el.value})()"
  ],
  [
    "scroll",
    "#theme"
  ],
  [
    "click",
    "#theme"
  ],
  [
    "wait",
    300
  ],
  [
    "shot",
    "shots/phone-dark.png",
    ".page",
    1
  ],
  [
    "scroll",
    "#time"
  ],
  [
    "drag",
    "#time",
    0.05,
    0.5,
    0.8,
    0.5,
    8
  ],
  [
    "until",
    "Number(document.querySelector('.stage').dataset.progress)>0.5 && document.querySelector('.stage').dataset.playing==='false'"
  ],
  [
    "key",
    "End",
    ".stage"
  ],
  [
    "until",
    "Number(document.querySelector('.stage').dataset.progress)===1"
  ],
  [
    "key",
    "1",
    ".stage"
  ],
  [
    "scroll",
    "[data-mark=\"3\"]"
  ],
  [
    "click",
    "[data-mark=\"3\"]"
  ],
  [
    "until",
    "document.querySelector('#metric-a').textContent==='0,90 m' && document.documentElement.scrollWidth===innerWidth"
  ],
  [
    "eval",
    "({reduced:matchMedia('(prefers-reduced-motion:reduce)').matches,lang:document.documentElement.lang,width:innerWidth,overflow:document.documentElement.scrollWidth>innerWidth})"
  ]
]
