[
  [
    "eval",
    "document.body.dataset.theme='light';document.getElementById('theme').setAttribute('aria-label','Cambiar al tema oscuro')"
  ],
  [
    "eval",
    "window.d=()=>document.querySelector('.laboratory').dataset;window.n=k=>Number(d()[k]);window.check=(c,m)=>{if(!c)throw Error(m);return m+' · correcto'};window.near=(a,b,t=1e-9)=>Math.abs(a-b)<t"
  ],
  [
    "eval",
    "check(d().reduced==='true'&&d().auto==='false'&&n('time')===0,\"Movimiento reducido manual\")"
  ],
  [
    "wait",
    200
  ],
  [
    "eval",
    "check(n('time')===0,\"Estado inicial inmóvil\")"
  ],
  [
    "lines",
    null,
    ".apparatus"
  ],
  [
    "eval",
    "document.getElementById(\"record\").click()"
  ],
  [
    "eval",
    "document.getElementById(\"record\").click()"
  ],
  [
    "eval",
    "check(n('records')===1,\"Sin duplicar el mismo instante\")"
  ],
  [
    "eval",
    "for(let i=0;i<16;i++)document.getElementById('step').click()"
  ],
  [
    "eval",
    "check(near(n('time'),.8)&&n('compression')>0&&n('U')>0&&n('force')>0,\"Compresión de los resortes\")"
  ],
  [
    "eval",
    "check(near(n('pA')+n('pB'),n('P0'))&&near(n('KA')+n('KB')+n('U'),n('E0'))&&near(n('impulseA'),-n('impulseB')),\"Conservación e impulsos opuestos\")"
  ],
  [
    "eval",
    "document.getElementById(\"record\").click()"
  ],
  [
    "eval",
    "for(let i=0;i<5;i++)document.getElementById('step').click()"
  ],
  [
    "eval",
    "check(near(n('vA'),0)&&near(n('vB'),.6)&&n('U')===0,\"Masas iguales intercambian velocidades\")"
  ],
  [
    "eval",
    "document.getElementById(\"record\").click()"
  ],
  [
    "eval",
    "check(n('records')===3&&document.getElementById('record').disabled,\"Cuaderno limitado a tres instantes\")"
  ],
  [
    "eval",
    "document.getElementById(\"compare\").click()"
  ],
  [
    "eval",
    "check(document.querySelectorAll('#records tr').length===3&&Number(document.querySelectorAll('#records tr')[1].lastElementChild.textContent.replace(',','.'))>0,\"Comparación analítica de tres fases\")"
  ],
  [
    "shot",
    "shots/desktop-light.png",
    ".page",
    1
  ],
  [
    "shot",
    "shots/junctions-light.png",
    ".stage",
    4
  ],
  [
    "lines",
    null,
    ".apparatus"
  ],
  [
    "eval",
    "document.getElementById(\"theme\").click()"
  ],
  [
    "shot",
    "shots/desktop-dark.png",
    ".page",
    1
  ],
  [
    "shot",
    "shots/junctions-dark.png",
    ".stage",
    4
  ],
  [
    "lines",
    null,
    ".apparatus"
  ],
  [
    "eval",
    "(()=>{const e=document.getElementById(\"mass-b\");e.value=\"0.4\";e.dispatchEvent(new Event(\"change\",{bubbles:true}))})()"
  ],
  [
    "eval",
    "check(n('records')===0&&n('massB')===.4&&document.querySelectorAll('[data-part^=\"B.weight.\"]').length===9,\"Masa y lastres de B\")"
  ],
  [
    "eval",
    "for(let i=0;i<22;i++)document.getElementById('step').click()"
  ],
  [
    "eval",
    "check(n('vA')<0&&n('vB')>0&&near(n('P'),n('P0')),\"Rebote contra B más pesado\")"
  ],
  [
    "lines",
    null,
    ".apparatus"
  ],
  [
    "eval",
    "document.querySelector('[data-preset=\"head\"]').click()"
  ],
  [
    "eval",
    "check(n('vA0')===.4&&n('vB0')===-.2&&n('massB')===.2,\"Configuración de choque frontal\")"
  ],
  [
    "eval",
    "for(let i=0;i<20;i++)document.getElementById('step').click()"
  ],
  [
    "eval",
    "check(near(n('vA'),-.2)&&near(n('vB'),.4),\"Intercambio con velocidades de signos opuestos\")"
  ],
  [
    "key",
    "Home",
    ".stage"
  ],
  [
    "eval",
    "(()=>{const e=document.getElementById(\"velocity-b\");e.value=\"0.2\";e.dispatchEvent(new Event(\"change\",{bubbles:true}))})()"
  ],
  [
    "eval",
    "check(n('vA0')===.2&&n('vB0')===.2&&d().encounter==='false'&&document.getElementById('compare').disabled,\"Prueba sin encuentro\")"
  ],
  [
    "eval",
    "for(let i=0;i<100;i++)document.getElementById('step').click()"
  ],
  [
    "eval",
    "check(d().done==='true'&&near(n('time'),n('end'))&&n('force')===0&&near(n('vA'),.2)&&near(n('vB'),.2),\"Límite del tramo sin choque con topes\")"
  ],
  [
    "key",
    "End",
    ".stage"
  ],
  [
    "key",
    "ArrowLeft",
    ".stage"
  ],
  [
    "eval",
    "check(n('vA0')===.75,\"Flechas de velocidad\")"
  ],
  [
    "eval",
    "document.querySelector('.stage').dispatchEvent(new KeyboardEvent('keydown',{key:'ArrowRight',shiftKey:true,bubbles:true}))"
  ],
  [
    "eval",
    "check(n('vA0')===.8,\"Paso de Mayús y límite\")"
  ],
  [
    "eval",
    "document.getElementById(\"reset\").click()"
  ],
  [
    "eval",
    "check(n('vA0')===.6&&n('vB0')===0&&n('massB')===.2&&n('time')===0&&n('rate')===.25&&n('records')===0,\"Restablecer parámetros\")"
  ],
  [
    "eval",
    "document.getElementById(\"launch\").click()"
  ],
  [
    "eval",
    "check(d().paused==='true'&&n('time')===0,\"Lanzamiento manual con movimiento reducido\")"
  ]
]
